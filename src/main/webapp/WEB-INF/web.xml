<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Shop</display-name>
    <filter>
        <filter-name>SetCharacterEncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceRequestEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>forceResponseEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>SetCharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>INCLUDE</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>
    <!-- Cấu hình servlet Home -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>toan.dev.HomeServlet</servlet-class>
    </servlet>


    <!--Cấu hình admin-->
    <!--cấu hình admin banner-->
    <servlet>
        <servlet-name>CreateBannerServlet</servlet-name>
        <servlet-class>toan.dev.admin.banners.CreateBannerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteBannerServlet</servlet-name>
        <servlet-class>toan.dev.admin.banners.DeleteBannerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditBannerServlet</servlet-name>
        <servlet-class>toan.dev.admin.banners.EditBannerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>IndexBannerServlet</servlet-name>
        <servlet-class>toan.dev.admin.banners.IndexBannerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/HomeServlet</url-pattern>
    </servlet-mapping>

     <!--cấu hình admin banner-->
    <servlet-mapping>
        <servlet-name>CreateBannerServlet</servlet-name>
        <url-pattern>/CreateBannerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteBannerServlet</servlet-name>
        <url-pattern>/DeleteBannerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditBannerServlet</servlet-name>
        <url-pattern>/EditBannerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>IndexBannerServlet</servlet-name>
        <url-pattern>/IndexBannerServlet</url-pattern>
    </servlet-mapping>

    <!-- Let default servlet serve static resources under /assets/* -->
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/assets/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/css/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/js/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/lib/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/img/*</url-pattern>
    </servlet-mapping>

    <!-- Public site servlet mappings -->


    <!-- Welcome file (trang mặc định) - redirect to HomeServlet -->
    <welcome-file-list>
        <welcome-file>HomeServlet</welcome-file>
    </welcome-file-list>
</web-app>